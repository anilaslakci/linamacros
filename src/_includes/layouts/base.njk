<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{{ title }}{% if title != site.name %} | {{ site.name }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}" />
  <meta name="theme-color" content="{{ site.themeColor }}" />
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
  <meta property="og:locale" content="{{ site.locale }}" />
  <meta property="og:site_name" content="{{ site.name }}" />
  <meta property="og:type" content="{% if layout == 'layouts/post.njk' %}article{% else %}website{% endif %}" />
  <meta property="og:title" content="{{ title }}{% if title != site.name %} | {{ site.name }}{% endif %}" />
  <meta property="og:description" content="{{ description or site.description }}" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  <meta property="og:image" content="{{ site.url }}/assets/images/lina-macros-og.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Lina Macros" />
  <meta name="twitter:card" content="summary_large_image" />
  {% if date %}<meta property="article:published_time" content="{{ date | htmlDate }}" />{% endif %}
  {% if updated %}<meta property="article:modified_time" content="{{ updated | htmlDate }}" />{% endif %}
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/styles.css" />
  <link rel="stylesheet" href="/assets/css/blog.css" />
  {% if layout == 'layouts/post.njk' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ title | dump | safe }},
    "description": {{ description | dump | safe }},
    "datePublished": "{{ date | htmlDate }}",
    "dateModified": "{{ (updated or date) | htmlDate }}",
    "inLanguage": "tr-TR",
    "mainEntityOfPage": {"@type": "WebPage", "@id": "{{ site.url }}{{ page.url }}"},
    "author": {"@type": "Organization", "name": "{{ site.author }}", "url": "{{ site.url }}/"},
    "publisher": {"@type": "Organization", "name": "{{ site.name }}", "url": "{{ site.url }}/", "logo": {"@type": "ImageObject", "url": "{{ site.url }}/icon-512.png"}}{% if tags %},
    "keywords": {{ tags | join(', ') | dump | safe }}{% endif %}
  }
  </script>
  {% else %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}/",
    "inLanguage": "tr-TR"
  }
  </script>
  {% if page.url == '/' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{% for faq in faqs | activeFaqs %}{% if not loop.first %},{% endif %}{"@type":"Question","name":{{ faq.question | dump | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ faq.answer | dump | safe }}}}{% endfor %}]
  }
  </script>
  {% endif %}
  {% endif %}
</head>
<body class="{% if bodyClass %}{{ bodyClass }}{% endif %}">
  <div class="page-shell">
    {% include "partials/header.njk" %}
    {{ content | safe }}
    {% include "partials/footer.njk" %}
  </div>
  {% include "partials/support-widget.njk" %}
  <aside class="consent-banner" data-consent-banner hidden aria-labelledby="consent-title">
    <div class="consent-copy">
      <h2 id="consent-title">Analitik çerez tercihi</h2>
      <p>Site kullanımını anlayıp iyileştirebilmek için Google Analytics kullanmak istiyoruz. Onay vermediğiniz sürece Analytics yüklenmez ve analitik çerez oluşturulmaz. <a href="/cerez-politikasi/">Ayrıntıları inceleyin</a>.</p>
    </div>
    <div class="consent-actions">
      <button class="consent-button" type="button" data-consent-reject>Reddet</button>
      <button class="consent-button" type="button" data-consent-accept>Kabul et</button>
    </div>
  </aside>
  <script>window.LINA_ANALYTICS_ID = {{ site.analyticsMeasurementId | dump | safe }};</script>
  <script src="/assets/js/consent-analytics.js" defer></script>
  <script src="/assets/js/script.js" defer></script>
  <script src="/assets/js/campaign.js" defer></script>
  <script src="/assets/js/support-widget.js" defer></script>
</body>
</html>
